# ============================================================
#  SHIRO x NEMESIS - settings file
#  Copy this file to ".env" and edit it.   (cp .env.example .env)
#  The real ".env" file is ignored by Git, so your secrets stay private.
# ============================================================

# --- Network -------------------------------------------------
# IP address of the ASUS Windows laptop (where Guardian runs).
# Nemesis (Ubuntu) sends events to this address.
SN_GUARDIAN_HOST=192.168.1.5
SN_GUARDIAN_PORT=8000

# On the ASUS laptop Guardian listens on all network cards so Ubuntu can reach it.
# (Windows Firewall will only allow your Ubuntu laptop in. See docs/05.)
SN_BIND_HOST=0.0.0.0

# --- Secret token --------------------------------------------
# A long random password shared by BOTH laptops.
# Create one with:   python scripts/generate_token.py
# Put the SAME value in the .env file on both laptops.
SN_TOKEN=

# --- Attack timing -------------------------------------------
# How often Nemesis launches a new attack (seconds). 1200 = 20 minutes.
SN_INTERVAL_SECONDS=1200

# --- AI (optional) -------------------------------------------
# Without a key everything still works using built-in rules.
# With a key, Nemesis plans attacks with AI and Guardian explains alerts with AI.
ANTHROPIC_API_KEY=
SN_AI_MODEL=claude-haiku-5-5
# Turn AI off on one side even if a key exists (true/false):
SN_NEMESIS_USE_AI=true
SN_GUARDIAN_USE_AI=true

# --- Nemesis behaviour ---------------------------------------
# Sometimes send a harmless "decoy" that looks scary (creates false positives
# so you can practise closing them). true/false
SN_INCLUDE_DECOYS=true

# --- Notifications (ASUS) ------------------------------------
# Show a Windows pop-up for alerts at or above this level:
# low | medium | high | critical
SN_MIN_TOAST_SEVERITY=medium

# --- Dashboard -----------------------------------------------
# false = dashboard can only be opened ON the ASUS laptop itself (safer).
# true  = other devices on your home Wi-Fi may open it too.
SN_DASHBOARD_ALLOW_LAN=false

# --- Data folder (optional) ----------------------------------
# Where databases and Shiro's fake files are stored. Default: ./data
# SN_DATA_DIR=
